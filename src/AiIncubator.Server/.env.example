# Backend secrets template. Copy to .env (gitignored) and fill in real values.
# Keys use the double-underscore section separator (Chat__ApiKey -> Chat:ApiKey).

# GLM (z.ai) chat API key
Chat__ApiKey=

# Clerk JWT validation (issuer = Clerk Frontend API URL, e.g. https://your-app.clerk.accounts.dev)
Clerk__Authority=
Clerk__Issuer=
Clerk__Audience=

# Internal BGE-Large embedding server (required for indexing and chat retrieval)
Embedding__ServerUrl=
